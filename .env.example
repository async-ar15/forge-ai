# Owns: documented environment variables for local and deployed ForgeAI stacks.
# Does not own: secret storage, key rotation, or per-tenant overrides (v2).

# --- PostgreSQL (Model Registry DB + routing_decisions) ---
DATABASE_URL=postgresql+asyncpg://forgeai:forgeai@localhost:5433/forgeai
# Alembic uses a synchronous driver URL (do not use the asyncpg scheme here).
ALEMBIC_DATABASE_URL=postgresql://forgeai:forgeai@localhost:5433/forgeai

# --- Redis (semantic cache, Bloom filter for cache_hit_prob) ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant (vector store / RAG) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Required: retrieval engine collection name (no default in Settings).
QDRANT_COLLECTION_NAME=forgeai-documents
QDRANT_TIMEOUT_SECONDS=2.0

# --- PCR semantic cache (retrieval service) ---
CACHE_TTL_SECONDS=3600
RETRIEVAL_BLOOM_FILTER_KEY=forgeai:bloom:retrieval

# --- Kafka (async metrics, training events, policy signals) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=forgeai-dev
KAFKA_CONSUMER_GROUP_ID=forgeai-default
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KRaft CLUSTER_ID for docker-compose (passed into the broker as CLUSTER_ID). Use a different value per
# project or clone when running multiple Kafka stacks locally so metadata on named volumes does not clash.
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

# --- S3-compatible object store (artifacts, checkpoints) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
MODEL_REGISTRY_BUCKET=forgeai-model-registry

# --- Online reward coefficients R_online = -a*L -b*C -c*SLO -d*F -e*R + f*cache ---
# Maps to tenant_policies.coeff_* in Postgres; v1 uses shared defaults loaded from env at process start.
REWARD_COEFF_LATENCY_MS=0.001
REWARD_COEFF_COST_USD=1.0
REWARD_COEFF_SLO_VIOLATION=10.0
REWARD_COEFF_FALLBACK=5.0
REWARD_COEFF_RETRY=3.0
REWARD_COEFF_CACHE_HIT_BONUS=2.0

# --- gRPC service targets (internal only; no REST between services) ---
POLICY_ENGINE_GRPC_HOST=127.0.0.1
POLICY_ENGINE_GRPC_PORT=50051
EXECUTION_ENGINE_GRPC_HOST=127.0.0.1
EXECUTION_ENGINE_GRPC_PORT=50052
RETRIEVAL_ENGINE_GRPC_HOST=127.0.0.1
RETRIEVAL_ENGINE_GRPC_PORT=50053
MODEL_REGISTRY_GRPC_HOST=127.0.0.1
MODEL_REGISTRY_GRPC_PORT=50054

# --- Policy Engine (LinUCB exploration; configurable, not hardcoded) ---
POLICY_EPSILON=0.05
# Disjoint LinUCB (Section 3): ridge prior / UCB width share LINUCB_ALPHA; ε-greedy rate below.
LINUCB_ALPHA=1.0
LINUCB_EXPLORATION_EPSILON=0.1
# In-process PolicyService listen port (``forgeai.policy.grpc_service.serve``).
POLICY_SERVICE_PORT=50051

# --- Execution Engine (vLLM wrapper; output budget enforcement) ---
EXECUTION_OUTPUT_TOKEN_CAP=8192

# --- Retrieval Engine (Bloom filter timing budget for explicit fallback path) ---
RETRIEVAL_BLOOM_TIMEOUT_MS=1

# --- Local demo model backend (Ollama; CPU-friendly quickstart path) ---
FORGEAI_DEMO_MODE=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi

# --- Gateway (FastAPI external API) ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_LOG_LEVEL=info

# --- Operational ---
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_METRICS_PORT=9100
